{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "verify": "npm test && npm run lint && npm run build",
    "build:static": "node scripts/build-static.mjs",
    "verify:static": "npm run build:static && node scripts/check-export.mjs",
    "security:check": "node scripts/security-check.mjs",
    "upgrade:security": "node scripts/upgrade-security.mjs",
    "release:check": "npm run verify && npm run security:check && npm run audit",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "next": "^15.1.3",
    "postcss": "^8.4.49",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17"
  }
}
