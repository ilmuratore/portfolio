{
  "name": "portfolio-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "verify": "npm test && npm run lint && npm run build",
    "build:static": "node scripts/build-static.mjs",
    "verify:static": "npm run build:static && node scripts/check-export.mjs",
    "security:check": "node scripts/security-check.mjs",
    "release:check": "npm run verify && npm run security:check && npm run audit",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "verify:pages": "npm run build:pages && npm run check:pages",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "next": "16.4.1",
    "postcss": "8.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  }
}
